---
import type { Link } from "../types";
import Button from "./Button.astro";
import Container from "./Container.astro";

interface Props {
  title: string;
  subtitle?: string;
  cta?: Link;
}

const { title, subtitle, cta } = Astro.props;
---

<div class="sy-hero-home relative overflow-hidden">
  <div
    class="absolute inset-0 before:absolute before:inset-0 before:h-full before:w-full before:bg-[image:var(--hero-gradient)] before:bg-center before:opacity-30 before:[mask:linear-gradient(0deg,rgba(0,0,0,0)_1%,rgba(0,0,0,1)_100%)] before:content-[''] after:absolute after:inset-0 after:h-full after:w-full after:[backdrop-filter:blur(5px)] after:content-['']"
  >
  </div>
  <Container>
    <div
      class="relative z-[1] flex min-h-[90vh] flex-row items-center justify-between pt-[8.5rem] pb-32 max-tablet:flex-col max-tablet:justify-center max-tablet:items-center max-tablet:text-center max-tablet:min-h-0 max-tablet:pt-[6.5rem] max-tablet:pb-20 max-phone:pt-[5.5rem] max-phone:pb-16"
    >
      <div class="max-tablet:flex max-tablet:flex-col max-tablet:items-center max-tablet:w-full max-tablet:max-w-xl">
        <div class="mb-4 hidden max-tablet:inline-flex items-center gap-2 rounded-full bg-brand-3/80 px-3.5 py-1 text-xs font-semibold text-brand-1 shadow-sm backdrop-blur-md">
          <span class="inline-block h-2 w-2 rounded-full bg-brand-2 animate-pulse"></span>
          Next-Gen Trading Platform
        </div>

        <h1
          class="whitespace-nowrap text-h2 leading-[1.08] max-tablet:whitespace-normal [&_.line2]:block [&_.accent]:font-bold [&_.accent]:text-brand-1"
          data-sy-reveal="words"
          set:html={title}
        />
        {
          subtitle ? (
            <p
              class="mt-6 max-w-[25em] text-lg max-tablet:mt-4 max-tablet:text-base max-tablet:max-w-[22em] max-tablet:mx-auto text-text-alt"
              data-sy-reveal="lines"
            >
              {subtitle}
            </p>
          ) : null
        }
        {
          cta ? (
            <div class="mt-8 max-tablet:mt-6 max-phone:w-full max-phone:max-w-xs">
              <Button
                {...cta}
                arrow
                class="max-phone:w-full max-phone:justify-center max-phone:min-h-[48px] max-phone:text-sm"
              />
            </div>
          ) : null
        }
      </div>

      <div
        data-gl-place
        class="pointer-events-none mt-[-2rem] h-[var(--s)] w-[var(--s)] [--s:24rem] max-desktop-lg:[--s:22rem] max-tablet:relative max-tablet:mt-6 max-tablet:mb-0 max-tablet:top-0 max-tablet:inset-x-0 max-tablet:mx-auto max-tablet:translate-y-0 [--s:16rem] max-phone:[--s:13rem]"
      >
      </div>
    </div>
  </Container>
</div>
