---
import type { Image } from "../types";

interface Props {
  class?: string;
  images: Image[];
}

const { images, class: className } = Astro.props;
---

<sy-gallery class:list={["relative flex w-full overflow-hidden", className]}>
  <div class="outer relative z-[1] flex-1">
    <div class="inner relative h-full w-full">
      {
        images.map((img) => {
          const isVideo = /\.(mp4|webm|mov)$/i.test(img.src);
          return (
            <div class="img absolute inset-0 h-full w-full overflow-hidden will-change-transform">
              {isVideo ? (
                <video
                  src={img.src}
                  aria-label={img.alt}
                  class="absolute h-full w-full object-cover"
                  autoplay
                  loop
                  muted
                  playsinline
                />
              ) : (
                <img {...img} class="absolute h-full w-full object-cover" />
              )}
            </div>
          );
        })
      }
    </div>
  </div>
  <div class="dots absolute inset-x-0 bottom-[0.6rem] z-[2] mx-auto flex w-min gap-2">
  </div>
</sy-gallery>

<script>
  import gsap from "gsap";

  const dotClasses =
    "h-[0.6rem] w-[0.6rem] cursor-pointer border-0 bg-white p-0 opacity-60 hover:opacity-80 [&.is-active]:opacity-100";

  class Gallery extends HTMLElement {
    currentIndex = 0;
    images: HTMLElement[];
    buttons: HTMLButtonElement[] = [];

    constructor() {
      super();

      this.images = [...this.querySelectorAll<HTMLElement>(".img")];
    }

    connectedCallback() {
      this.initDots();
      gsap.set(this.images, {
        xPercent: (i) => (i === 0 ? 0 : 100),
      });
    }

    initDots() {
      const { images } = this;

      const dots = this.querySelector(".dots") as HTMLElement;
      dots.innerHTML = "";
      this.buttons = [];

      images.forEach((_item, i) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = dotClasses;
        if (i === 0) btn.classList.add("is-active");
        btn.addEventListener("click", () => this.goto(i));
        btn.innerHTML = `<span class="sr-only">show image ${i + 1}</span>`;
        dots.append(btn);
        this.buttons.push(btn);
      });
    }

    goto(index: number) {
      const { images, buttons, currentIndex } = this;

      if (index === currentIndex || !images[index]) return;

      buttons[currentIndex].classList.remove("is-active");
      buttons[index].classList.add("is-active");

      images.forEach((img, i) => {
        const xPercent = i < index ? -100 : i > index ? 100 : 0;
        gsap.to(img, {
          xPercent,
          duration: 0.9,
          ease: "power3.inOut",
          overwrite: true,
        });
      });

      this.currentIndex = index;
    }
  }

  customElements.define("sy-gallery", Gallery);
</script>
