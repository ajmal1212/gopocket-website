---
import Button from "./Button.astro";
import Logo from "../assets/logo.svg";
import NavMenuItem from "./NavMenuItem.astro";
import type { Link, NavEntry } from "../types";
import { Search } from "@lucide/astro";

interface Props {
  logoUrl: string;
  logoAlt: string;
  navLinks: NavEntry[];
  link1?: Link;
  link2?: Link;
  currentPath?: string;
}

const { logoUrl, logoAlt, link1, link2, navLinks, currentPath = "" } =
  Astro.props;
---

<header>
  <sy-head
    class="fixed inset-x-0 top-0 z-10 mx-auto text-text transition-transform duration-300 ease-out-cubic [body.is-nav-hidden_&]:-translate-y-full before:absolute before:inset-0 before:-z-[1] before:content-[''] after:absolute after:inset-0 after:-z-[1] after:origin-top after:scale-y-0 after:bg-brand-3/70 after:backdrop-blur-[15px] after:transition-transform after:duration-300 after:ease-out-cubic after:content-[''] [body.is-nav-small_&]:after:scale-y-100"
  >
    <div
      class="mx-auto w-[calc(100%-3rem)] max-w-[1300px] py-4 transition-[padding] duration-300 ease-out-cubic max-desktop-sm:w-[calc(100%-3rem)] max-tablet:w-[calc(100%-2rem)] max-phone:w-[calc(100%-1.5rem)] [body.is-nav-small_&]:py-2"
    >
      <div class="relative flex items-center justify-between gap-4">
        <!-- Left Side: Logo + Nav Links -->
        <div class="flex items-center gap-6 lg:gap-8">
          <a class="relative z-[3] flex items-center shrink-0 min-h-[44px] active:scale-95 transition-transform" href={logoUrl}>
            <Logo class="block h-auto w-30 max-phone:w-25" />
            <span class="sr-only">{logoAlt}</span>
          </a>

          <nav
            aria-label="Primary"
            class="max-tablet:fixed max-tablet:inset-0 max-tablet:z-[2] max-tablet:flex max-tablet:flex-col max-tablet:h-screen max-tablet:w-screen max-tablet:items-start max-tablet:justify-start max-tablet:overflow-y-auto max-tablet:bg-white/98 max-tablet:backdrop-blur-2xl max-tablet:pt-[max(5rem,env(safe-area-inset-top))] max-tablet:pb-[max(3rem,env(safe-area-inset-bottom))] max-tablet:px-5 max-tablet:transition-[opacity,visibility,transform] max-tablet:duration-300 max-tablet:ease-out-expo [body:not(.is-nav-opened)_&]:max-tablet:pointer-events-none [body:not(.is-nav-opened)_&]:max-tablet:opacity-0 [body:not(.is-nav-opened)_&]:max-tablet:-translate-y-2 [body.is-nav-opened_&]:max-tablet:opacity-100 [body.is-nav-opened_&]:max-tablet:translate-y-0"
          >
            <!-- Search bar inside mobile menu -->
            <div class="w-full mb-3 sm:hidden pt-2">
              <div class="relative flex items-center w-full">
                <Search class="absolute left-3.5 h-4 w-4 text-gray-400 pointer-events-none" />
                <input
                  type="text"
                  placeholder="Search GoPocket...."
                  class="header-search-input w-full rounded-xl border border-gray-200/80 bg-gray-50 py-2.5 pl-10 pr-4 text-sm text-text placeholder:text-gray-400 focus:border-brand-1 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-1/20 transition-all shadow-xs"
                />
              </div>
            </div>

            <ul
              class="nav-list m-0 flex list-none items-center gap-[1.125em] p-0 text-sm max-tablet:w-full max-tablet:flex-col max-tablet:gap-2.5 max-tablet:items-start"
            >
              {
                navLinks.map((item) => (
                  <li class="max-tablet:w-full">
                    <NavMenuItem item={item} currentPath={currentPath} />
                  </li>
                ))
              }
            </ul>

            {
              link2 ? (
                <div class="mt-5 w-full max-tablet:block hidden">
                  <Button {...link2} fullWidth revealable={false} size="lg" />
                </div>
              ) : null
            }
          </nav>
        </div>

        <!-- Right Side: Search Input + Open Account Button -->
        <div class="z-[2] flex items-center gap-3 shrink-0">
          <div class="relative hidden sm:flex items-center">
            <div class="relative flex items-center w-48 md:w-56 lg:w-64">
              <Search class="absolute left-3 h-4 w-4 text-gray-400 pointer-events-none" />
              <input
                type="text"
                placeholder="Search GoPocket...."
                class="header-search-input w-full rounded-xl border border-gray-200/80 bg-white/90 py-2 pl-9 pr-14 text-xs text-text placeholder:text-gray-400 focus:border-brand-1 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-1/20 transition-all shadow-xs"
              />
              <kbd class="absolute right-2.5 rounded border border-gray-200 bg-gray-50 px-1.5 py-0.5 text-[10px] font-medium text-gray-400 font-mono pointer-events-none">Ctrl+K</kbd>
            </div>
          </div>

          {
            link1 ? (
              <a
                href={link1.url}
                class="relative translate-y-0 text-sm transition-[transform,color] duration-300 ease-out-expo after:pointer-events-none after:absolute after:top-[115%] after:left-0 after:h-[2px] after:w-full after:origin-right after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-out-expo after:content-[''] hover:after:origin-left hover:after:scale-x-100 focus:after:origin-left focus:after:scale-x-100 max-phone:hidden"
              >
                {link1.title}
              </a>
            ) : null
          }
          {link2 ? <Button {...link2} revealable={false} /> : null}

          <button
            type="button"
            class="toggle hidden cursor-pointer items-center justify-center border-0 bg-none p-2 text-brand-1 min-h-[44px] min-w-[44px] rounded-lg active:bg-brand-1/10 transition-colors duration-300 ease-out-expo max-tablet:flex [.has-no-bg_&]:text-brand-3 [body.is-nav-opened_&]:text-brand-1 [body.is-nav-small_&]:text-brand-1"
            aria-label="Toggle Mobile Navigation Menu"
          >
            <span class="sr-only">Toggle Mobile Menu</span>
            <span aria-hidden class="flex h-5 w-7 flex-col justify-between">
              <span class="flex h-[3.5px] w-full origin-center rounded-[10px] bg-current [transform:translateZ(0)] transition-transform duration-200 ease-out-cubic [body.is-nav-opened_&]:[transform:translateY(calc(0.55rem-1px))_rotate(45deg)]" />
              <span class="flex h-[3.5px] w-full origin-center rounded-[10px] bg-current [transform:translateZ(0)] transition-opacity duration-200 ease-out-cubic [body.is-nav-opened_&]:opacity-0" />
              <span class="flex h-[3.5px] w-full origin-center rounded-[10px] bg-current [transform:translateZ(0)] transition-transform duration-200 ease-out-cubic [body.is-nav-opened_&]:[transform:translateY(calc(-0.55rem+1px))_rotate(-45deg)]" />
            </span>
          </button>
        </div>
      </div>
    </div>
  </sy-head>
</header>

<script>
  import { addScrollObserver } from "../utils/observers";

  const heroSelectors = ["sy-hero-home"];

  class Header extends HTMLElement {
    smallThreshold = 100;
    hiddenThreshold = 200;
    toggleEl = this.querySelector(".toggle")!;
    hero = document.querySelector(heroSelectors.join(","));
    prevY = -1;

    constructor() {
      super();

      addScrollObserver(this);

      this.toggleEl.addEventListener("click", this.toggleNav);
      this.initDropdowns();

      // Close mobile menu on link click
      this.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          document.body.classList.remove("is-nav-opened");
        });
      });

      const searchInput = this.querySelector<HTMLInputElement>(".header-search-input");
      if (searchInput) {
        document.addEventListener("keydown", (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
            e.preventDefault();
            searchInput.focus();
          }
        });
      }

      this.onResize();
      this.onScroll(window.scrollY);
    }

    onScroll(y: number) {
      const isDown = y > this.prevY ? true : false;
      this.prevY = y;

      const classList = document.body.classList;

      const shouldBeSmall = y > this.smallThreshold;
      const isSmall = classList.contains("is-nav-small");

      if (shouldBeSmall !== isSmall) {
        classList.toggle("is-nav-small", shouldBeSmall);
      }

      const shouldBeHidden = y > this.hiddenThreshold && isDown;
      const isHidden = classList.contains("is-nav-hidden");

      if (shouldBeHidden !== isHidden) {
        classList.toggle("is-nav-hidden", shouldBeHidden);
      }
    }

    toggleNav = () => {
      document.body.classList.toggle("is-nav-opened");
    };

    onResize() {
      const hero = this.hero;
      const bcr = this.getBoundingClientRect();
      const heroBcr = hero && hero.getBoundingClientRect();

      this.smallThreshold = heroBcr ? heroBcr.height - bcr.height : bcr.height;
    }

    initDropdowns() {
      const navItems = Array.from(
        this.querySelectorAll<HTMLElement>(".nav-item"),
      );

      const closeItem = (item: HTMLElement) => {
        const toggle = item.querySelector<HTMLButtonElement>(
          ":scope > .nav-toggle",
        )!;
        const panel = item.querySelector<HTMLElement>(
          ":scope > .nav-panel",
        )!;

        item.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        panel.hidden = true;
      };

      const openItem = (item: HTMLElement) => {
        const toggle = item.querySelector<HTMLButtonElement>(
          ":scope > .nav-toggle",
        )!;
        const panel = item.querySelector<HTMLElement>(
          ":scope > .nav-panel",
        )!;

        item.classList.add("is-open");
        toggle.setAttribute("aria-expanded", "true");
        panel.hidden = false;
      };

      const closeAll = (except?: HTMLElement) => {
        navItems.forEach((item) => {
          if (item !== except) closeItem(item);
        });
      };

      const closeSiblings = (item: HTMLElement) => {
        // Close sibling dropdowns at the same level, but leave ancestors
        // (for nested items like ReKYC inside Sign In) untouched.
        const parentItem = item.parentElement?.closest<HTMLElement>(
          ".nav-item",
        );
        const siblingScope = parentItem
          ? Array.from(
              parentItem.querySelectorAll<HTMLElement>(":scope .nav-item"),
            ).filter((n) => n.parentElement?.closest(".nav-item") === parentItem)
          : navItems.filter((n) => !n.parentElement?.closest(".nav-item"));

        siblingScope.forEach((sibling) => {
          if (sibling !== item) closeItem(sibling);
        });
      };

      let leaveTimer: ReturnType<typeof setTimeout> | undefined;

      navItems.forEach((item) => {
        const toggle = item.querySelector<HTMLButtonElement>(
          ":scope > .nav-toggle",
        );
        if (!toggle) return;

        toggle.addEventListener("click", (e) => {
          e.stopPropagation();

          const expanded = item.classList.contains("is-open");
          closeSiblings(item);

          if (expanded) {
            closeItem(item);
          } else {
            openItem(item);
          }
        });

        item.addEventListener("mouseenter", () => {
          clearTimeout(leaveTimer);
          closeSiblings(item);
          openItem(item);
        });

        item.addEventListener("mouseleave", () => {
          leaveTimer = setTimeout(() => closeItem(item), 150);
        });
      });

      document.addEventListener("click", (e) => {
        if (!(e.target as HTMLElement).closest(".nav-item")) closeAll();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeAll();
      });
    }
  }

  customElements.define("sy-head", Header);
</script>
