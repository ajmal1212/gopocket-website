---
type CommonProps = {
  class?: string;
  color?: "primary" | "primary-alt";
  size?: "sm" | "md" | "lg";
  arrow?: boolean;
  fullWidth?: boolean;
  title: string;
  revealable?: boolean;
  manualReveal?: boolean;
};

type AnchorProps = {
  url: string;
  target?: string;
  type?: never;
} & CommonProps;

type ButtonProps = {
  url?: never;
  target?: never;
  type?: "button" | "submit" | "reset";
} & CommonProps;

type Props = AnchorProps | ButtonProps;

const {
  title,
  url,
  target,
  class: className = "",
  type = "button",
  color = "primary",
  size = "md",
  arrow = false,
  fullWidth = false,
  revealable = true,
  manualReveal = false,
} = Astro.props;

const Element = url ? "a" : "button";

const attrs =
  Element === "a"
    ? {
        target,
        href: url,
      }
    : {
        type,
      };

const isAlt = color === "primary-alt";
const bgClass = isAlt ? "bg-brand-3" : "bg-brand-1";
const textClass = isAlt ? "text-text" : "text-white";
const ringClass = isAlt ? "after:border-brand-3" : "after:border-brand-1";
const arrowBgClass = isAlt ? "bg-brand-3" : "bg-brand-1";

const sizeClasses =
  size === "sm"
    ? "min-h-[38px] text-[0.75rem] px-4 py-2"
    : size === "lg"
    ? "min-h-[50px] text-sm px-6 py-4"
    : "min-h-[44px] text-xs px-[1.5em] py-[0.8em]";
---

<Element
  class:list={[
    "group relative m-0 inline-flex items-center justify-center cursor-pointer overflow-hidden rounded-full border-0 bg-transparent p-0 font-semibold tracking-[0.02em] touch-action-manipulation active:scale-[0.97] transition-transform duration-150 ease-out-cubic",
    fullWidth && "w-full",
    revealable &&
      "[clip-path:inset(0_100%_0_0_round_100px)] translate-x-8 origin-left transition-[opacity,clip-path,transform] duration-[0.4s] ease-out-cubic [&.is-in]:[clip-path:inset(0_0_round_100px)] [&.is-in]:translate-x-0",
    className.toString(),
  ]}
  {...attrs}
  data-sy-reveal={revealable ? "" : undefined}
  data-sy-reveal-manual={manualReveal ? "" : undefined}
>
  <span
    class:list={[
      "relative flex w-full h-full items-center justify-center gap-2.5 rounded-[99px] transition-colors duration-300",
      bgClass,
      textClass,
      sizeClasses,
    ]}
  >
    <span>{title}</span>
    {arrow && (
      <span
        class="flex h-[1.75em] w-[1.75em] shrink-0 items-center justify-center rounded-full bg-white transition-transform duration-200 group-hover:translate-x-1 group-focus:translate-x-1"
      >
        <span
          class:list={[
            "block h-[1em] w-[1em] [mask:var(--icon-arrow)_no-repeat_center/contain]",
            arrowBgClass,
          ]}
        />
      </span>
    )}
  </span>
</Element>
