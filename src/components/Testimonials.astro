---
import Container from "./Container.astro";
import TestimonialCard from "./TestimonialCard.astro";
import { organizationSchema } from "../utils/seo";

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Loved by investors like you",
  subtitle = "Real feedback from real GoPocket users, trading and investing every day.",
} = Astro.props;

function initials(name: string) {
  return name
    .split(" ")
    .map((p) => p[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
}

const testimonials = organizationSchema.review
  .filter((r) => r.reviewBody)
  .map((r) => ({
    name: r.author.name,
    initials: initials(r.author.name),
    rating: Number(r.reviewRating.ratingValue),
    quote: r.reviewBody!,
  }));

const mid = Math.ceil(testimonials.length / 2);
const rowA = testimonials.slice(0, mid);
const rowB = testimonials.slice(mid);
---

<div class="sy-testimonials relative overflow-hidden py-4">
  <Container>
    <h2 class="mx-auto max-w-[20em] text-center" data-sy-reveal="words">
      {title}
    </h2>
    <p
      class="mx-auto mt-4 max-w-[36em] text-center text-text-alt"
      data-sy-reveal="lines"
    >
      {subtitle}
    </p>
  </Container>

  <div class="mt-14 flex flex-col gap-6 [mask-image:linear-gradient(90deg,transparent,black_8%,black_92%,transparent)]">
    <div class="flex w-max animate-marquee-x gap-6 hover:[animation-play-state:paused] max-tablet-sm:gap-4 motion-reduce:animate-none">
      {
        [...rowA, ...rowA].map((t, i) => (
          <div
            class="w-[21rem] shrink-0 max-tablet-sm:w-[17rem]"
            aria-hidden={i >= rowA.length ? "true" : undefined}
          >
            <TestimonialCard {...t} />
          </div>
        ))
      }
    </div>

    <div class="flex w-max animate-marquee-x gap-6 [animation-direction:reverse] [animation-duration:52s] hover:[animation-play-state:paused] max-tablet-sm:gap-4 motion-reduce:animate-none">
      {
        [...rowB, ...rowB].map((t, i) => (
          <div
            class="w-[21rem] shrink-0 max-tablet-sm:w-[17rem]"
            aria-hidden={i >= rowB.length ? "true" : undefined}
          >
            <TestimonialCard {...t} />
          </div>
        ))
      }
    </div>
  </div>
</div>
