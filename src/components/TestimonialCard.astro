---
import { Quote, Star } from "@lucide/astro";

interface Props {
  name: string;
  initials: string;
  rating: number;
  quote: string;
}

const { name, initials, rating, quote } = Astro.props;
---

<div
  class="flex h-full w-full flex-col justify-between rounded-2xl border border-brand-3 bg-white p-6 shadow-[0_4px_20px_rgba(0,0,0,0.05)]"
>
  <div>
    <Quote class="h-6 w-6 text-brand-3" fill="currentColor" stroke="none" />
    <p class="mt-3 line-clamp-5 text-sm text-text-alt">{quote}</p>
  </div>
  <div class="mt-6 flex items-center gap-3">
    <div
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-3 text-sm font-medium text-brand-1"
    >
      {initials}
    </div>
    <div>
      <p class="text-sm font-medium text-text">{name}</p>
      <div class="mt-0.5 flex gap-0.5 text-brand-2">
        {
          Array.from({ length: rating }).map(() => (
            <Star class="h-3.5 w-3.5" fill="currentColor" stroke="none" />
          ))
        }
      </div>
    </div>
  </div>
</div>
