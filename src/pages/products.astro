---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";

const products = [
  {
    title: "Equity",
    text: "Buy and sell from 30,000+ stocks across NSE and BSE, with live market depth and a single-click order flow.",
  },
  {
    title: "Mutual Funds",
    text: "Explore 40,000+ mutual fund schemes with zero custody fees and robo-advisory guidance to match your goals.",
  },
  {
    title: "IPOs",
    text: "Apply for IPOs directly from the app in a few taps, with real-time allotment status and UPI-based blocking.",
  },
  {
    title: "Futures & Options",
    text: "Trade F&O with fast execution, margin visibility, and tools built for both hedging and speculation.",
  },
  {
    title: "Currencies",
    text: "Trade USD-INR, EUR-INR, GBP-INR and JPY-INR pairs with transparent, low-cost pricing.",
  },
  {
    title: "Commodities",
    text: "Access commodity markets with competitive leverage and dedicated research to inform every position.",
  },
];
---

<Layout
  title="Products"
  description="Explore GoPocket's full range of investment products — Equity, Mutual Funds, IPOs, Futures & Options, Currencies and Commodities, all on one platform."
>
  <Section class="pt-40">
    <Container class="text-center">
      <h1 class="mx-auto max-w-[16em]" data-sy-reveal="words">
        Infinite investment options, one platform
      </h1>
      <p
        class="mx-auto mt-6 max-w-[40em] text-lg text-text-alt"
        data-sy-reveal="lines"
      >
        Whatever you want to invest in — stocks, funds, IPOs, derivatives, currencies or commodities — GoPocket brings it all into a single, fast, transparent app.
      </p>
    </Container>
  </Section>

  <Section class="pt-0">
    <Container>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          products.map((p) => (
            <div class="rounded-2xl border border-brand-3 bg-white p-8">
              <h3>{p.title}</h3>
              <p class="mt-3 text-text-alt">{p.text}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <Section class="pt-0 pb-40 text-center">
    <Container>
      <h2 class="mx-auto max-w-[16em]" data-sy-reveal="words">
        Ready to start investing?
      </h2>
      <p
        class="mx-auto mt-4 max-w-[32em] text-text-alt"
        data-sy-reveal="lines"
      >
        Open a free GoPocket account in about 5 minutes and get access to every product on this page.
      </p>
      <Button title="Open Free Account" url="/#pricing" arrow class="mt-8" />
    </Container>
  </Section>
</Layout>
